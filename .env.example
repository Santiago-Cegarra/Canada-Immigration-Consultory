# BASE DE DATOS (PostgreSQL / Prisma)
# Variables usadas por los contenedores de Docker Compose (`db`, `migrate`, `app`)
POSTGRES_USER="migration"
POSTGRES_PASSWORD="migration"
POSTGRES_DB="migration_canada"
POSTGRES_PORT="5433"

# Conexión desde tu máquina local (host -> contenedor en puerto 5433) o Neon en producción.
# Dentro de Docker Compose, los servicios `app` y `migrate` construyen su propia URL
# apuntando al host interno `db:5432` usando las variables POSTGRES_* de arriba.
DATABASE_URL="postgresql://migration:migration@localhost:5433/migration_canada?schema=public"

# APLICACIÓN
PORT="3000"
APP_URL="http://localhost:3000" # URL pública del sitio (usada en `src/lib/base-url.ts` para redirecciones de Stripe)

# AUTH.JS
# Obligatorio. Genera uno propio con `npx auth secret` (o `openssl rand -base64 32`).
# Nunca uses un valor de ejemplo: quien lo conozca puede firmar sesiones de admin.
AUTH_SECRET=""
AUTH_TRUST_HOST="true" # Necesario cuando la app corre detrás de proxy inverso o Docker
AUTH_RESEND_KEY="re_123456789" # Clave de API de Resend para Auth.js y notificaciones

# Usuario admin inicial, para `pnpm db:seed-admin`. Contraseña de 12 caracteres o más.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# STRIPE
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
