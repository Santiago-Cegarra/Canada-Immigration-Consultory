generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Auth.js (NextAuth) Models for Staff (Admins and Professionals)
// -----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?   // <- Agregado para login tradicional
  image         String?
  role          Role      @default(PROFESSIONAL)
  
  accounts      Account[]
  sessions      Session[]
  
  // Relations for professional
  appointments  Appointment[] @relation("ProfessionalAppointments")
  formTokens    FormToken[]   @relation("ProfessionalTokens")
  schedule      ProfessionalSchedule?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProfessionalSchedule {
  id             String   @id @default(cuid())
  professionalId String   @unique
  professional   User     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  title          String   @default("Consultor migratorio regulado (RCIC)")
  timeZone       String   @default("America/Toronto")
  weekdays       Int[]    @default([3])
  startTimes     String[] @default(["09:30", "11:15", "14:30", "16:15", "18:00"])
  active         Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  PROFESSIONAL
}

// -----------------------------------------------------------------------------
// Appointments
// -----------------------------------------------------------------------------
model Appointment {
  id              String   @id @default(cuid())
  professionalId  String
  professional    User     @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  
  clientName      String
  clientEmail     String
  clientPhone     String?
  
  startTime       DateTime
  endTime         DateTime
  
  // Payment info
  stripeSessionId String?  @unique
  paymentStatus   PaymentStatus @default(PENDING)

  // Rescheduling & notifications
  rescheduleTokenHash     String?   @unique
  rescheduleTokenEncrypted String?
  rescheduledCount        Int       @default(0)
  lastRescheduledAt       DateTime?
  meetingUrl              String?
  confirmationEmailSentAt DateTime?
  reminderEmailId         String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([professionalId, startTime])
  @@index([paymentStatus, startTime])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// -----------------------------------------------------------------------------
// Reusable Form Templates
// -----------------------------------------------------------------------------
model FormTemplate {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  sectionKeys String[]           @default([])
  status      FormTemplateStatus @default(DRAFT)
  currentVersion Int             @default(0)

  accessTokens FormToken[]
  versions FormTemplateVersion[]
  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Snapshot inmutable del cuestionario tal como se mostró al visitante.
// Los IDs de las respuestas en JSONB se interpretan con estas definiciones.
model FormTemplateVersion {
  id             String       @id @default(cuid())
  formTemplateId String
  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Restrict)
  version        Int
  schemaHash     String
  name           String
  slug           String
  compositionKeys String[]
  sections       Json         @db.JsonB
  submissions    FormSubmission[]
  createdAt      DateTime     @default(now())

  @@unique([formTemplateId, version])
  @@index([formTemplateId, createdAt])
}

enum FormTemplateStatus {
  DRAFT
  PUBLISHED
}

// -----------------------------------------------------------------------------
// Forms & Submissions
// -----------------------------------------------------------------------------
model FormToken {
  id              String   @id @default(cuid())
  token           String   @unique // SHA-256 de la clave; nunca se guarda la clave legible
  tokenEncrypted  String?  // Copia cifrada para que el admin pueda recuperarla
  tokenHint       String?  // Últimos caracteres para identificarla en el panel
  formTemplateId  String?
  formTemplate    FormTemplate? @relation(fields: [formTemplateId], references: [id], onDelete: Restrict)
  
  professionalId  String
  professional    User     @relation("ProfessionalTokens", fields: [professionalId], references: [id])
  
  expiresAt       DateTime
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  
  submissions     FormSubmission[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([formTemplateId])
}

model FormSubmission {
  id                    String              @id @default(cuid())
  tokenId               String
  token                 FormToken           @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  formTemplateId        String?             // Nulo solo para envíos anteriores sin plantilla vinculada
  formTemplate          FormTemplate?       @relation(fields: [formTemplateId], references: [id], onDelete: Restrict)
  formTemplateVersionId String?             // Nulo solo para envíos anteriores sin snapshot histórico
  formTemplateVersion   FormTemplateVersion? @relation(fields: [formTemplateVersionId], references: [id], onDelete: Restrict)
  personName            String
  personEmail           String?
  status                FormSubmissionStatus @default(SUBMITTED)
  responses             Json                @db.JsonB // Bloques y preguntas por ID canónico
  sensitiveResponses    Json?               @db.JsonB // Salud/antecedentes, acceso limitado al administrador

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formTemplateId, createdAt])
  @@index([formTemplateVersionId])
  @@index([tokenId, createdAt])
  @@index([status, createdAt])
}

enum FormSubmissionStatus {
  SUBMITTED
  IN_REVIEW
  COMPLETED
}
